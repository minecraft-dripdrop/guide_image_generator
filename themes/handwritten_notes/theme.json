    "line": "#D8C8B6",
    "line_dark": "#AFA293",
    "margin": "#C97870",
    "separator": "#CDBEAE",
    "highlighter": "#F9E3B7",
    "reward_note": "#F7E3B2",
    "tape": "#E5D0A8",
    "chip": "#E9D8C4",
    "title_highlighter": "#EED9C6",
    "day_highlighter": "#EFE0CF",
    "special_highlighter": "#E8C3B9",
    "section_highlighter": "#EFD9C9",
    "marker_fill": "#AA453E",
    "review_highlighter": "#FFD8D3"
  }
