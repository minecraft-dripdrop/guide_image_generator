{
  "surface_mode": "light",
  "renderer": {
    "style": "handwritten_notes",
    "font_path": "fonts/濑户字体简体.ttf",
    "font_scale": 3.5,
    "font_weight": 2,
    "font_tracking": 1.2,
    "author_avatar_outline_ratio": 0.1,
    "group_avatar_outline_ratio": 0.1,
    "author_avatar_size": 32,
    "group_avatar_size": 32,
    "circle_special_days": true,
    "special_day_circle_color": "#B64B43",
    "special_day_circle_width": 3,
    "budget_title": "① 先算预算",
