  "background": {
    "type": "vertical_gradient",
    "top": "$colors.background_top",
    "center": "$colors.background_center",
    "bottom": "$colors.background_bottom",
    "split": 0.45
  },
  "effects": [
    {
      "type": "light_rays",
      "count": 8,
      "origin": [
        0.48,
        -0.05
      ],
      "spread": 0.72,
      "color": "$colors.ray",
      "opacity": [
        7,
        20
      ]
    },
    {
      "type": "radial_glow",
      "position": [
        0.22,
        0.18
      ],
      "radius": 370,
      "color": "#3DE0E5",
      "opacity": 0.1
    },
    {
      "type": "particles",
      "count": 440,
      "size": [
        1,
        2
      ],
      "opacity": [
        12,
        55
      ],
      "colors": [
        "$colors.particle",
        "#FFFFFF"
      ],
      "blur": 0.4
    },
    {
      "type": "bubbles",
      "count": 70,
      "radius": [
        3,
        18
      ],
      "opacity": [
        25,
        95
      ],
      "color": "$colors.bubble",
      "y_range": [
        0.05,
        0.96
      ]
    },
    {
      "type": "pattern",
      "kind": "scales",
      "spacing": 90,
      "size": 46,
      "color": "#63DDE2",
      "opacity": 10
    },
    {
      "type": "vignette",
      "opacity": 110,
      "inset": 0.72,
      "color": "#010B13"
    }
  ],
  "risk": {
    "primary": "#E17784",
    "panel": "#30242D",
    "bubble": "#402A33",
    "border": "#875A66",
    "text": "#FFE0E4"
