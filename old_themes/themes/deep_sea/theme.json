    "background_center": "#07384D",
    "background_bottom": "#021725",
    "text": "#E9FAFC",
    "secondary_text": "#A8D5DB",
    "title_text": "#FFFFFF",
    "panel": "#0D3040",
    "panel_secondary": "#092838",
    "card": "#123B4B",
    "card_secondary": "#174756",
    "card_highlight": "#145466",
    "card_border": "#31899A",
    "border": "#31899A",
    "day_header": "#14566A",
    "day_header_text": "#E9FCFF",
    "kpi_card": "#123D4E",
    "kpi_border": "#3A91A1",
